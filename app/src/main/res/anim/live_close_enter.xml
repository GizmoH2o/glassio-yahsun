<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen back from Live TV: it rises from where it sank to. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/ease_out" android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="300" />
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="340" />
</set>
