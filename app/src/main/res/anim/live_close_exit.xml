<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV going: it fades as it grows a touch (the way it came, a little quicker). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/ease_in" android:shareInterpolator="true" android:zAdjustment="top">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="240" />
    <scale android:fromXScale="1" android:toXScale="1.02" android:fromYScale="1" android:toYScale="1.02"
        android:pivotX="50%" android:pivotY="50%" android:duration="240" />
</set>
