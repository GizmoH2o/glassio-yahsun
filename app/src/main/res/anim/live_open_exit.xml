<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen under Live TV as it comes in: it sinks back a little and fades. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/ease_out" android:shareInterpolator="true">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="380" />
    <scale android:fromXScale="1" android:toXScale="0.96" android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" android:duration="380" />
</set>
